{
  "name": "deck-curfew",
  "version": "0.2.0",
  "description": "Freedom-style schedule-based game blocker for Steam Deck (Decky Loader).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichielSaey/deck-curfew.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "curfew",
    "freedom",
    "self-control"
  ],
  "author": "Michiel Saey <michiel.saey@proton.me>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/MichielSaey/deck-curfew/issues"
  },
  "homepage": "https://github.com/MichielSaey/deck-curfew#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
